{
  "name": "rogue-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "npx --yes eslint .",
    "format:check": "npx --yes prettier --check \"README.md\" \"docs/**/*.md\" \".github/**/*.yml\" \"*.json\"",
    "format": "npx --yes prettier --write \"src/**/*.{ts,css}\" \"*.{json,md,yml,yaml}\"",
    "art:build": "python3 scripts/art/paint-camouflage.py && node scripts/art/build-models.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
